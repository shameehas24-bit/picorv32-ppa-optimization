--- rtl/orig/picorv32.v	2026-10-23 06:23:58.649823696 +0000
+++ rtl/opt/picorv32.v	2026-10-23 08:22:05.244319168 +0000
@@ -1226,23 +1226,39 @@
 	reg [31:0] alu_shl, alu_shr;
 	reg alu_eq, alu_ltu, alu_lts;
 
+	// PPA (E1): one shared subtractor yields both the signed and unsigned less-than results
+	// (the original used two separate comparators).
+	wire [32:0] alu_cmp_diff = {1'b0, reg_op1} - {1'b0, reg_op2};
+	wire alu_ltu_w = alu_cmp_diff[32];
+	wire alu_lts_w = (reg_op1[31] == reg_op2[31]) ? alu_cmp_diff[32] : reg_op1[31];
+
+	// PPA (E2): one shared right shifter serves both directions. A left shift is performed as
+	// bit-reverse -> logical right shift -> bit-reverse (reversal is only wiring).
+	function [31:0] rev32(input [31:0] x);
+		integer k;
+		for (k = 0; k < 32; k = k + 1) rev32[k] = x[31-k];
+	endfunction
+	wire alu_shift_left = instr_sll || instr_slli;
+	wire [31:0] alu_shift_in = alu_shift_left ? rev32(reg_op1) : reg_op1;
+	wire [31:0] alu_shift_res = $signed({instr_sra || instr_srai ? reg_op1[31] : 1'b0, alu_shift_in}) >>> reg_op2[4:0];
+
 	generate if (TWO_CYCLE_ALU) begin
 		always @(posedge clk) begin
 			alu_add_sub <= instr_sub ? reg_op1 - reg_op2 : reg_op1 + reg_op2;
 			alu_eq <= reg_op1 == reg_op2;
-			alu_lts <= $signed(reg_op1) < $signed(reg_op2);
-			alu_ltu <= reg_op1 < reg_op2;
-			alu_shl <= reg_op1 << reg_op2[4:0];
-			alu_shr <= $signed({instr_sra || instr_srai ? reg_op1[31] : 1'b0, reg_op1}) >>> reg_op2[4:0];
+			alu_lts <= alu_lts_w;
+			alu_ltu <= alu_ltu_w;
+			alu_shl <= rev32(alu_shift_res);
+			alu_shr <= alu_shift_res;
 		end
 	end else begin
 		always @* begin
 			alu_add_sub = instr_sub ? reg_op1 - reg_op2 : reg_op1 + reg_op2;
 			alu_eq = reg_op1 == reg_op2;
-			alu_lts = $signed(reg_op1) < $signed(reg_op2);
-			alu_ltu = reg_op1 < reg_op2;
-			alu_shl = reg_op1 << reg_op2[4:0];
-			alu_shr = $signed({instr_sra || instr_srai ? reg_op1[31] : 1'b0, reg_op1}) >>> reg_op2[4:0];
+			alu_lts = alu_lts_w;
+			alu_ltu = alu_ltu_w;
+			alu_shl = rev32(alu_shift_res);
+			alu_shr = alu_shift_res;
 		end
 	end endgenerate
 
